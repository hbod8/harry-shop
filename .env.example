# Copy to .env (never committed) and fill in. Use Stripe *test* keys locally.

# Stripe dashboard > Developers > API keys (sandbox): sk_test_...
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:8090/shop/stripe/webhook`: whsec_...
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends buyers back to
SITE_URL=http://127.0.0.1:8090
# Flat shipping per card order, in cents (0 = no shipping charge)
SHIPPING_CENTS=600
# true once Stripe Tax is set up (origin address, WA registration)
STRIPE_AUTOMATIC_TAX=false
